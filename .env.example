# Django settings
DEBUG=True
ALLOWED_HOSTS=*

# Host MySQL connection (Option 2: connects to existing host MySQL via network_mode: host)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345678
CUSTOMER_DB_NAME=customer_order_db
AGENT_DB_NAME=agent_order_db

# Service ports exposed on host
CUSTOMER_BFF_PORT=8001
AGENT_BFF_PORT=8002
CUSTOMER_ORDER_GRPC_PORT=50051
AGENT_ORDER_GRPC_PORT=50052

# Django secret keys (replace in non-dev environments)
CUSTOMER_BFF_SECRET_KEY=customer-bff-insecure-key-for-development-only-123
AGENT_BFF_SECRET_KEY=agent-bff-insecure-key-for-operations-development-456
CUSTOMER_SERVICE_SECRET_KEY=django-customer-order-service-secret-key-12345678
AGENT_SERVICE_SECRET_KEY=django-agent-order-service-secret-key-87654321

